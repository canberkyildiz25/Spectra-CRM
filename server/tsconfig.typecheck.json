{
  // `npm run build` yalnızca src/ derliyor, çünkü dist/ düzeni ona göre.
  // Serverless girişi api/ altında ve o derlemeye girmediği için hiç
  // denetlenmiyordu. Bu yapılandırma ikisini birlikte, çıktı üretmeden kontrol
  // eder — Vercel'e bozuk tip göndermeyelim.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*", "api/**/*"],
  "exclude": ["node_modules", "dist"]
}
